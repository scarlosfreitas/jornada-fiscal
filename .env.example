# Copie este arquivo para `.env` na raiz do projeto e ajuste os valores.
# Nenhum valor abaixo é um segredo real.

# Database Configuration
# POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB inicializam o serviço `db`
# do docker-compose (via env_file) e compõem o DATABASE_URL abaixo. Os dois
# precisam ser alterados juntos — o Prisma lê só o DATABASE_URL.
POSTGRES_USER="jornada_fiscal"
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_DB="jornada_fiscal"
DATABASE_URL="postgresql://jornada_fiscal:troque-esta-senha@db:5432/jornada_fiscal?schema=public"

# Porta em que o Postgres é publicado na máquina hospedeira (opcional).
# Padrão: 5432. Se a porta já estiver em uso, NÃO defina esta variável aqui —
# o Compose interpola variáveis a partir do .env que está no diretório do
# arquivo de composição, então este valor precisa ir em .devcontainer/.env.
# POSTGRES_HOST_PORT=5432

# NextAuth.js Configuration
# Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-um-valor-com-openssl-rand--base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Application Configuration
NEXT_PUBLIC_APP_NAME="JornadaFiscal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed: administrador inicial (prisma/seed.ts)
# Sem estas variáveis, o seed usa um fallback só para desenvolvimento — não
# rode `prisma db seed` em produção sem defini-las.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"
SEED_ADMIN_NOME="Nome"
SEED_ADMIN_SOBRENOME="Sobrenome"

# Diretório com os payloads reais da API (SATE), fora do controle de versão.
# Preferir um caminho fora da árvore do repositório — ver fontes/README.md.
# Sem esta variável, usa-se ./fontes; sem os arquivos, cai nos mocks fictícios.
FONTES_DIR=
