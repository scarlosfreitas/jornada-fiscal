# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Devcontainer ────────────────────────────────────────────

# Segredos / config local
.devcontainer/.env

# Python
__pycache__/
*.py[cod]
.venv/
uv.lock.tmp

# undetected-chromedriver (binário baixado em runtime)
*chromedriver*

settings.local.json

# Worktrees adicionais (checkout de outros branches dentro da própria árvore)
/.worktrees/

# ── Fontes de dados ─────────────────────────────────────────
# Payloads da API (SATE) com dado real de contribuinte. Este repositório é
# PÚBLICO e esses arquivos são protegidos por sigilo fiscal (CTN art. 198):
# nada aqui dentro pode ser versionado. Só o README escapa.
# Ver references/api/README.md.
/fontes/*
!/fontes/README.md

# ── Fim ─────────────────────────────────────────────────────/.claude/worktrees/

.obsidian